{
  "name": "digital-inventory-and-sales-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Digital Inventory and Sales Management System for Karnataka Kirana and Retail Stores",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --prefix server run start",
    "seed": "npm --prefix server run prisma:seed",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
